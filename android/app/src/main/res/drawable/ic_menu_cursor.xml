<?xml version="1.0" encoding="utf-8"?>
<!-- The ring-and-dot cursor beside the chosen entry. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="18dp" android:height="18dp">
        <shape android:shape="oval">
            <stroke android:width="2dp" android:color="#EDBB00" />
            <solid android:color="#0A1B45" />
        </shape>
    </item>
    <item android:width="8dp" android:height="8dp" android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#DC0014" />
        </shape>
    </item>
</layer-list>
