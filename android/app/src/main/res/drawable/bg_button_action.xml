<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#66EDBB00">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <solid android:color="#8A93A6" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#14317A" android:endColor="#0A1B45" />
                    <stroke android:width="1dp" android:color="#DC0014" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
